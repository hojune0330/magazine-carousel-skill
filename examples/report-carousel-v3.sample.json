      "source_start": 0,
      "source_end": 0,
      "asset_id": null,
      "photo_forbidden": true
    },
    {
      "page": 7,
      "type": "table",
      "title": "2026 시즌 세계 여자 육상 800m Top 15",
      "source_start": 0,
      "source_end": 0,
      "asset_id": null,
      "photo_forbidden": true
    },
    {
