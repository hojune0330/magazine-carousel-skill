{
  "profile": "report-carousel-v3.1-large-type-adaptive-fill",
  "canvas": {
    "width": 1080,
    "height": 1350,
    "aspect_ratio": "4:5"
  },
  "mode": {
    "render_engine": "deterministic",
    "image_gen_for_layout": false,
    "source_preserving": true,
    "fixed_page_count": 20,
    "render_all_pages_in_one_run": true,
    "typography_preset": "source-dense-large",
    "adaptive_fill": true,
    "two_pass_rebalance": true
  },
  "brand": {
    "label": "ELITE REPORT",
    "credit": "@io_magazine / 장호준 코치",
    "accent": "#FFD300",
    "background": "#FAF9F6"
  },
  "typography": {
    "main_title": {"size": 56, "line_height": 66},
    "section_title": {"size": 36, "line_height": 47},
    "subtitle": {"size": 30, "line_height": 41},
    "body": {"size": 21, "line_height": 32},
    "caption": {"size": 17, "line_height": 25},
    "table": {"size": 14, "line_height": 20},
    "reference": {"size": 11, "line_height": 16}
  },
  "fill_targets": {
    "normal_vertical_fill": [0.86, 0.97],
    "panel_utilization": [0.72, 0.92],
    "table_vertical_fill": [0.72, 0.92],
    "max_unintentional_blank_band_px": 140,
    "max_body_footer_gap_px": 180
  },
  "rules": {
    "table_pages_have_no_photos": true,
    "foreground_photo_fit": "contain",
    "foreground_crop": false,
    "blurred_same_image_background": true,
    "default_max_uses_per_asset": 1,
    "fixed_typography": true,
    "font_follows_layer": false,
    "layer_follows_measured_text": true,
    "ten_image_generation_limit_applies": false
  },
  "source": {
    "path": "source.txt",
    "sha256": "<source-sha256>",
    "character_count": 0
  },
  "assets": [
    {
      "id": "photo-01",
      "path": "assets/photo-01.jpg",
      "origin": "user-upload",
      "sha256": "<asset-sha256>",
      "perceptual_hash": "<phash>",
      "source_url": null,
      "author": null,
      "license": null,
      "used_on": [1]
    }
  ],
  "pages": [
    {
      "page": 1,
      "type": "cover-photo",
      "title": "2026 세계 여자 육상 800m 시즌 결산",
      "source_start": 0,
      "source_end": 0,
      "asset_id": "photo-01",
      "expected_text_height": 340,
      "panel_height": 410,
      "vertical_fill_target": 0.84
    },
    {
      "page": 2,
      "type": "photo-bottom-panel",
      "title": "2026년, 여자 육상 800m 역사의 새로운 패러다임",
      "source_start": 0,
      "source_end": 900,
      "asset_id": "photo-02",
      "expected_text_height": 520,
      "panel_height": 600,
      "panel_utilization_target": 0.84
    },
    {
      "page": 6,
      "type": "table-balanced",
      "title": "2026 시즌 세계 여자 육상 800m Top 15",
      "source_start": 0,
      "source_end": 0,
      "asset_id": null,
      "photo_forbidden": true,
      "row_height_range": [64, 118],
      "table_vertical_fill_target": 0.84
    },
    {
      "page": 10,
      "type": "photo-bottom-panel",
      "title": "킬리 호킨슨",
      "source_start": 0,
      "source_end": 1000,
      "asset_id": "photo-10",
      "next_page_source_start": 1000,
      "expected_text_height": 610,
      "panel_height": 690
    },
    {
      "page": 11,
      "type": "table-balanced",
      "title": "4.1. 대회 출전 이력 및 성과",
      "source_start": 1000,
      "source_end": 1800,
      "asset_id": null,
      "photo_forbidden": true,
      "previous_page_source_end": 1000,
      "table_vertical_fill_target": 0.86
    },
    {
      "page": 12,
      "type": "source-highlight",
      "title": "도쿄의 아쉬움과 실내 시즌의 대폭발",
      "highlight": "1:54.87",
      "source_start": 1800,
      "source_end": 2800,
      "asset_id": "photo-12",
      "highlight_in_body": false
    },
    {
      "page": 20,
      "type": "sources",
      "title": "결론 및 향후 전망",
      "source_start": 0,
      "source_end": 0,
      "asset_id": "photo-20"
    }
  ],
  "qa": {
    "missing_chars": 0,
    "duplicated_chars": 0,
    "order_mismatch": 0,
    "offset_gaps": 0,
    "offset_overlaps": 0,
    "unintentional_blank_bands": 0,
    "body_font_below_20": 0,
    "table_pages_with_photos": 0
  },
  "deliverables": [
    "01.png",
    "20.png",
    "<slug>.zip",
    "<slug>_preview.jpg",
    "<slug>_preview.png",
    "source.txt",
    "text-manifest.txt",
    "page-map.json",
    "asset-map.json",
    "IMAGE_SOURCES.md",
    "QA_REPORT.md"
  ]
}
